# ---------------------------------------------------------------------------
# Jekyll build output
# ---------------------------------------------------------------------------
/_site/
/.jekyll-cache/
/.sass-cache/
/.jekyll-metadata

# ---------------------------------------------------------------------------
# Bundler (gems are installed per machine)
# ---------------------------------------------------------------------------
/.bundle/
/vendor/
*.gem

# The lock file is generated locally and depends on the platform and Ruby
# version. It is not committed so that `bundle install` can resolve versions
# for the machine that builds the site (see "Requirements" in README.md).
# Commit it instead if you want to pin exact versions and match the Ruby
# version of your CI workflow.
/Gemfile.lock

# ---------------------------------------------------------------------------
# Node.js tooling (optional, if you add a JS pipeline)
# ---------------------------------------------------------------------------
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Editors and IDE files
# ---------------------------------------------------------------------------
/.vscode/
/.idea/
*.iml
/.history/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Operating system files
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
Thumbs.db
ehthumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Local environment and secrets
# ---------------------------------------------------------------------------
.env
.env.*
!/.env.example

# Logs and merge leftovers
*.log
*.orig
*.rej
